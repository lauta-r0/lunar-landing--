{
  "hosting": {
    "public": "web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "README.md"],
    "rewrites": [
      { "source": "/api/**", "run": { "serviceId": "lunascout-api", "region": "southamerica-east1" } }
    ],
    "headers": [
      { "source": "**/*.@(js|css)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] }
    ]
  }
}
